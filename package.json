{
  "name": "kite-chronicle-zerodha-simulator",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cross-env VITE_API_MODE=http tsx server/index.ts",
    "sync": "tsx server/syncCli.ts",
    "export:data": "tsx scripts/exportData.ts",
    "export:profiles": "tsx scripts/exportProfiles.ts",
    "parity": "tsx scripts/parity.ts",
    "icons": "pwa-assets-generator",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "express": "^4.21.2",
    "idb-keyval": "^6.3.0",
    "lightweight-charts": "4.2.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
